# Zalex production configuration
ZALEX_BASE_DIR=/opt/zalex/storage
ZALEX_DOCS_DIR=/opt/zalex/storage/docs
ZALEX_DATA_DIR=/opt/zalex/storage
ZALEX_MAX_CONTEXT=3500
ZALEX_MAX_REACT_STEPS=8
ZALEX_WATCHER_DEBOUNCE=2
ZALEX_WATCHER_STABLE=1

# Franki / llama-server
FRANKI_BASE_URL=http://10.0.0.2:8080
FRANKI_MODEL=franki_v4
FRANKI_TEMPERATURE=0.15
FRANKI_TIMEOUT=180
FRANKI_MAX_TOKENS=512

# Knowledge embeddings: 'hash' works locally; 'llama' requires a llama-server
# configured with an embedding-capable model and /v1/embeddings enabled.
ZALEX_EMBEDDING_MODE=hash
ZALEX_EMBEDDING_BASE_URL=http://10.0.0.2:8080
ZALEX_EMBEDDING_MODEL=franki_v4
